# dnsmasq config schema — canonical source of truth for every tunable.
#
# The dnsmasq config itself is written by pcs (`pcs reconcile`), not set here.
# Validate: varlock load --path .
#
# @defaultSensitive=false @defaultRequired=infer
# ---

## Image
# @type=string
DNSMASQ_IMAGE=docker.io/dockurr/dnsmasq
# @type=string
DNSMASQ_TAG=2.93

## Injected by pcm — do not set
# Root of pcm service volumes.
# @required @type=string
PCM_VOLUMES_HOME=
