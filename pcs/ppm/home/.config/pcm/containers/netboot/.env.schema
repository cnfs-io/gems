# netboot config schema — canonical source of truth for every tunable.
#
# What gets served is written by pcs (`pcs reconcile`), not set here.
# Validate: varlock load --path .
#
# @defaultSensitive=false @defaultRequired=infer
# ---

## Image
# @type=string
NETBOOT_IMAGE=docker.io/netbootxyz/netbootxyz
# @type=string
NETBOOT_TAG=0.7.6-nbxyz24

## Network (the host's; nothing is port-mapped)
# HTTP for installers and preseeds. Must match pcs's netboot.http_port.
# @type=port
NETBOOT_HTTP_PORT=8080
# netboot.xyz's web UI (menus and local assets).
# @type=port
NETBOOT_WEB_PORT=3000

## Misc
# @type=string
NETBOOT_TIMEZONE=UTC

## Injected by pcm — do not set
# Root of pcm service volumes.
# @required @type=string
PCM_VOLUMES_HOME=
