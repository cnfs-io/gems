# Generated by pcs for <%= site.name %> (<%= mode %> mode); `pcs reconcile` rewrites it.
# To change it, copy pcs's template into the project's templates/ directory.
<%- if mode == "proxy" -%>
#
# Proxy DHCP: the site's DHCP server still hands out addresses; this only
# tells PXE clients where to boot from. TFTP is served by the netboot container.
<%- end -%>

# No DNS: the site has its own.
port=0
bind-dynamic
log-dhcp
<%- networks.each do |network| -%>

# <%= network.name %> (<%= network.subnet %>): boots from <%= network.control_plane_ip %>
<%- if network.control_plane_interface.present? -%>
interface=<%= network.control_plane_interface %>
<%- end -%>
<%- if mode == "proxy" -%>
dhcp-range=<%= network.address %>,proxy,<%= network.netmask %>
<%- else -%>
dhcp-range=<%= network.dhcp_start %>,<%= network.dhcp_end %>,<%= network.netmask %>,12h
dhcp-option=option:router,<%= network.gateway %>
dhcp-option=option:dns-server,<%= network.nameservers.join(",") %>
<%- end -%>
pxe-prompt="PXE boot from <%= site.name %>",1
pxe-service=x86PC,"netboot.xyz (BIOS)",netboot.xyz.kpxe,<%= network.control_plane_ip %>
pxe-service=x86-64_EFI,"netboot.xyz (UEFI)",netboot.xyz.efi,<%= network.control_plane_ip %>
pxe-service=ARM64_EFI,"netboot.xyz (ARM64 UEFI)",netboot.xyz-arm64.efi,<%= network.control_plane_ip %>
<%- end -%>
<%- if mode == "dhcp" && reservations.any? -%>

# Reservations: each configured host always gets its address.
<%- reservations.each do |iface| -%>
dhcp-host=<%= iface.mac %>,<%= iface.configured_ip %>,<%= iface.host.hostname %>
<%- end -%>
<%- end -%>
