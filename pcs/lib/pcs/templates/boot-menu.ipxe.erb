#!ipxe
# Generated by pcs for <%= host.fqdn %> (<%= interface.mac %>); `pcs reconcile` rewrites it.
<%- if target.install? -%>
# Install requested: boots the Debian installer unless another item is chosen.
<%- end -%>

:start
menu pcs: <%= host.fqdn %> (<%= interface.configured_ip %>)
item local       Boot from disk
item install     Install Debian <%= target.codename %> (<%= target.arch %>) on <%= host.disk %>, erasing it
item netbootxyz  netboot.xyz menu
item shell       iPXE shell
choose --timeout <%= timeout_ms %> --default <%= target.install? ? "install" : "local" %> selected || goto local
goto ${selected}

:local
exit

:install
imgfree
kernel <%= target.kernel_url %> initrd=<%= target.initrd_name %> <%= target.kernel_params %> || goto failed
initrd <%= target.initrd_url %> || goto failed
boot || goto failed

:netbootxyz
chain --autofree menu.ipxe || goto failed

:shell
shell
goto start

:failed
echo Boot failed. Press a key for the menu.
prompt
goto start
