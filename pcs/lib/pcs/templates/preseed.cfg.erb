# Generated by pcs for <%= host.fqdn %>; `pcs reconcile` rewrites it.
# Served over HTTP: it holds only a public key and, at most, a password hash.

# Locale and keyboard (also on the kernel command line, for the first questions)
d-i debian-installer/locale string <%= install.locale %>
d-i keyboard-configuration/xkb-keymap select <%= install.keymap %>

# Network: the address comes from the kernel command line (static from the start)
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string <%= host.hostname %>
d-i netcfg/get_domain string <%= host.site&.domain %>
d-i netcfg/hostname string <%= host.hostname %>
d-i hw-detect/load_firmware boolean true

# Mirror
d-i mirror/country string manual
d-i mirror/http/hostname string <%= mirror.host %><%= ":#{mirror.port}" unless [80, 443].include?(mirror.port) %>
d-i mirror/http/directory string <%= mirror.path %>
d-i mirror/http/proxy string
d-i mirror/suite string <%= target.codename %>
d-i apt-setup/non-free-firmware boolean true

# Accounts: no root login; one admin user, reached with pcs's key
d-i passwd/root-login boolean false
d-i passwd/make-user boolean true
d-i passwd/user-fullname string <%= install.user %>
d-i passwd/username string <%= install.user %>
<%- if install.password_hash -%>
d-i passwd/user-password-crypted password <%= install.password_hash %>
<%- else -%>
# No password: the account is reached with pcs's key only
d-i passwd/user-password-crypted password !
<%- end -%>

# Clock
d-i clock-setup/utc boolean true
d-i time/zone string <%= host.site&.timezone || "UTC" %>
d-i clock-setup/ntp boolean true

# Disk: all of <%= host.disk %>, erased
d-i partman-auto/disk string <%= host.disk %>
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
d-i partman-efi/non_efi_system boolean true
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i grub-installer/only_debian boolean true
d-i grub-installer/bootdev string <%= host.disk %>

# Packages
d-i base-installer/install-recommends boolean false
d-i base-installer/kernel/image string linux-image-<%= target.arch %>
tasksel tasksel/first multiselect standard, ssh-server
d-i pkgsel/include string <%= Array(install.packages).join(" ") %>
d-i pkgsel/upgrade select safe-upgrade
popularity-contest popularity-contest/participate boolean false
<%- unless install.password_hash -%>
openssh-server openssh-server/password-authentication boolean false
<%- end -%>

# Finish: sudo without a password, pcs's key, then the post-install hook
d-i preseed/late_command string \
    echo '<%= install.user %> ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/<%= install.user %>; \
    chmod 440 /target/etc/sudoers.d/<%= install.user %>; \
    mkdir -p /target/home/<%= install.user %>/.ssh; \
    echo '<%= public_key %>' > /target/home/<%= install.user %>/.ssh/authorized_keys; \
    chmod 700 /target/home/<%= install.user %>/.ssh; \
    chmod 600 /target/home/<%= install.user %>/.ssh/authorized_keys; \
    in-target chown -R <%= install.user %>:<%= install.user %> /home/<%= install.user %>/.ssh; \
    wget -q -O /target/root/pcs-post-install.sh <%= target.post_install_url %> && \
    in-target sh /root/pcs-post-install.sh
d-i finish-install/reboot_in_progress note
