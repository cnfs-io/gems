# Fedora Kickstart Configuration
# Generated by pim (Product Image Manager)

text
skipx
firstboot --disable
# pim waits for the installer VM to power off
poweroff

# Installation source - netinst ISOs carry no packages, so install from the mirrors
url --mirrorlist="https://mirrors.fedoraproject.org/mirrorlist?repo=fedora-$releasever&arch=$basearch"

# Locale, keyboard, timezone
lang <%= locale %>
keyboard --xlayouts=<%= keyboard %>
timezone <%= timezone %>

# Network
network --bootproto=dhcp --device=link --activate --hostname=<%= hostname %>

# Partitioning - use entire disk, plain partitions (no LVM)
zerombr
clearpart --all --initlabel --disklabel=gpt
autopart --type=plain --noswap
bootloader --timeout=1

# User account
rootpw --lock
user --name=<%= username %> --gecos="<%= fullname %>" --password=<%= password %> --plaintext --groups=wheel

selinux --enforcing
firewall --enabled --service=ssh
services --enabled=sshd,qemu-guest-agent

%packages
@core
<%= packages.to_s.split.join("\n") %>
%end

# Sudoers setup (always) + optional authorized_keys and post-install script
%post --log=/root/ks-post.log
echo "<%= username %> ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/<%= username %>
chmod 440 /etc/sudoers.d/<%= username %>
<% if authorized_keys_url %>
mkdir -p /home/<%= username %>/.ssh
curl -fsSL "<%= authorized_keys_url %>" -o /home/<%= username %>/.ssh/authorized_keys
chmod 700 /home/<%= username %>/.ssh
chmod 600 /home/<%= username %>/.ssh/authorized_keys
chown -R <%= username %>:<%= username %> /home/<%= username %>/.ssh
restorecon -R /home/<%= username %>/.ssh
<% end %>
<% if install_url %>
curl -fsSL "<%= install_url %>" -o /tmp/install.sh && /bin/bash /tmp/install.sh
<% end %>
%end
